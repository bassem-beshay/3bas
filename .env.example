# Multi-Tenant Fashion E-Commerce Platform Environment Variables

# Backend Configuration
DJANGO_SECRET_KEY=fashion-saas-insecure-secret-key-change-in-production-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*.localhost

# Database Configuration (Defaults to local SQLite if DATABASE_URL is not provided)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fashion_saas

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_DEFAULT_STORE_SLUG=noire
